# Copy to .env.local for development. Never commit real values.

# Optional. Set both to put the facilitator view behind a sign-in form for a live session,
# so the room cannot casually open the reveal notes. Leave either unset or blank and the
# view is open, as in the open-access build. This is a convenience gate, not a security
# boundary — static JavaScript is readable, and nothing behind it is sensitive.
VITE_FACILITATOR_USERNAME=
VITE_FACILITATOR_PASSWORD=

# Optional. Unset or unreachable means polling reports itself unavailable and all six
# scenario modules continue to work unchanged.
#
#   local development: run `npm run polling:dev`, then use the URL below
#   deployed:          the CloudFront origin, e.g. https://dxxxxxxxx.cloudfront.net
#                      (same origin as the site, so /api/* needs no CORS)
VITE_POLLING_API_URL=http://127.0.0.1:8787

# --- GitHub Pages deployment only (see deploy/README.md, "GitHub Pages") ---

# Build-command-only, read by vite.config.ts straight from the shell. Deliberately not
# loaded from this file or .env.local: a stray value would move the dev server to the
# sub-path too, and every Playwright spec resolves against a root baseURL.
#
#   VITE_BASE_PATH=/modeling-choices-omics-ashg2026 npm run build
#
# Unset for CloudFront and local development. A missing trailing slash is normalised —
# BASE_URL is used as a bare prefix, so it must have one.

# If VITE_POLLING_API_URL is unset and this is set, the opening poll points at an
# externally hosted poll (Slido, Mentimeter, Poll Everywhere) instead of reporting itself
# unavailable. The in-platform backend always takes precedence over these. Only http(s)
# URLs are honoured; anything else is ignored as if unset.
VITE_EXTERNAL_POLL_URL=
# Optional. Defaults to the question in backend/polling/poll.mjs.
VITE_EXTERNAL_POLL_QUESTION=
# Optional. The poll tool's presenter view, linked from the facilitator run sheet.
VITE_EXTERNAL_POLL_RESULTS_URL=
# Optional. Projected instead of the raw URL, e.g. "slido.com  #2026".
VITE_EXTERNAL_POLL_LABEL=
