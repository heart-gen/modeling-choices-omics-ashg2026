{
  "name": "@omics-modeling-choices/web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node ../../scripts/sync-data.mjs && node ../../scripts/validate-scenarios.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.0"
  }
}
